{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "correction.schema.json",
  "title": "Correcciones (solo campos NO contables)",
  "type": "object",
  "required": ["corrections"],
  "properties": {
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["transaction_id", "field", "value"],
        "properties": {
          "transaction_id": {"type": "string"},
          "field": {"type": "string", "enum": ["category", "review_status", "type", "tag"],
                    "description": "NUNCA fecha/importe/saldo (regla 24/40)"},
          "value": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  }
}
